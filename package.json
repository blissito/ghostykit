{
  "name": "ghosty-autopilot-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w ghosty-autopilot",
    "test": "npm test -w ghosty-autopilot",
    "typecheck": "npm run typecheck -w ghosty-autopilot",
    "demo": "npm run build -w ghosty-autopilot && npm run dev -w ghosty-autopilot-demo"
  }
}
